# Copia este fichero a .env y cambia los valores. NUNCA subas .env al repositorio.
POSTGRES_USER=taxigest
POSTGRES_PASSWORD=cambia_esta_contraseña
POSTGRES_DB=taxigest

DATABASE_URL=postgresql+psycopg://taxigest:cambia_esta_contraseña@db:5432/taxigest
IMAGES_DIR=/app/uploads

# Clave para firmar los tokens JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_esta_clave_por_una_aleatoria_y_larga
